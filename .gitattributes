# These are executed on a Linux VM. Committed from Windows they would
# otherwise pick up CRLF and fail with "bad interpreter: /usr/bin/env bash^M".
*.sh            text eol=lf
Jenkinsfile     text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
docker-compose*.yml text eol=lf
Dockerfile      text eol=lf
# The deploy parses this on Linux; CRLF here makes Odoo skip every module.
modules.txt     text eol=lf
