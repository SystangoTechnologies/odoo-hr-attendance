# Copy to .env and fill in real values before running deploy.sh.
# .env is gitignored and must never be committed.

# Must match the branch the addon repos are on (18.0). The module manifests
# are 18.0.x and will not load on 17.0.
ODOO_VERSION=18.0

# NOTE: Compose interpolates $ in .env values. A literal $ in a password
# must be written as $$, or just avoid $ entirely.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-strong-password

# Odoo master password -- guards /web/database/manager (create/drop/backup).
# Rendered into odoo.conf; the official image ignores an ADMIN_PASSWORD env
# var, so this is the only thing that actually sets it.
ODOO_ADMIN_PASSWORD=change-me-strong-password

# Single database holding all four products' modules.
ODOO_DB_NAME=odoo

# Must be >= 1. At 0 Odoo handles websockets in-process on 8069, nothing
# listens on the gevent port 8072, and nginx's /websocket route 502s.
ODOO_WORKERS=2

# Port nginx publishes. 80/443 are already taken by other services on this
# VM -- pick a free one and check with `ss -tlnp`.
HTTP_PORT=8092
