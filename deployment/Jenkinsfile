pipeline {
    agent any

    // Trigger manually, on a schedule, or via webhook from any of the 4 addon
    // repos. Only this repo carries deployment/; the other three are pulled
    // on the VM by clone.sh.
    // triggers { cron('H 2 * * *') }

    parameters {
        booleanParam(
            name: 'UPGRADE_MODULES',
            defaultValue: true,
            description: 'Run odoo -u over modules.txt so pulled code takes effect. ' +
                         'Uncheck for a plain restart.'
        )
    }

    environment {
        DEPLOY_DIR  = '/opt/odoo-deploy'
        // Secret Text credential holding e.g. deploy@10.0.0.5.
        // Must NOT be a username/password credential -- those bind as
        // DEPLOY_HOST_USR / DEPLOY_HOST_PSW instead of DEPLOY_HOST.
        DEPLOY_HOST = credentials('odoo-vm-ssh-host')
        SSH_CRED_ID = 'odoo-vm-ssh-key'
    }

    stages {
        stage('Checkout odoo-hr-attendance (contains deployment/)') {
            steps {
                checkout scm
            }
        }

        stage('Sync repo to VM') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no "$DEPLOY_HOST" "mkdir -p $DEPLOY_DIR"
                        rsync -avz --delete \
                          -e "ssh -o StrictHostKeyChecking=no" \
                          --exclude '.git' \
                          --exclude 'deployment/addons' \
                          --exclude 'deployment/.env' \
                          --exclude 'deployment/odoo.conf' \
                          --exclude 'deployment/versions.lock' \
                          ./ "$DEPLOY_HOST:$DEPLOY_DIR/"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    script {
                        def flag = params.UPGRADE_MODULES ? '--upgrade' : ''
                        sh """
                            ssh -o StrictHostKeyChecking=no "\$DEPLOY_HOST" \
                              'cd \$DEPLOY_DIR/deployment && chmod +x clone.sh deploy.sh && ./deploy.sh ${flag}'
                        """
                    }
                }
            }
        }

        stage('Health check') {
            steps {
                sshagent(credentials: [env.SSH_CRED_ID]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no "$DEPLOY_HOST" '
                          set -e
                          cd '"$DEPLOY_DIR"'/deployment
                          docker compose ps
                          . ./.env
                          for i in $(seq 1 30); do
                            code=$(curl -s -o /dev/null -w "%{http_code}" \
                                     "http://127.0.0.1:${HTTP_PORT:-8092}/web/login") || code=000
                            echo "attempt $i: HTTP $code"
                            [ "$code" = "200" ] && exit 0
                            sleep 5
                          done
                          echo "Odoo did not return 200 on /web/login"
                          docker compose logs --tail=100 odoo
                          exit 1
                        '
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Deployment failed -- check stage logs above.'
        }
        success {
            echo 'Deployed. Odoo (all four repos, one Apps list) is up on $HTTP_PORT.'
        }
    }
}
