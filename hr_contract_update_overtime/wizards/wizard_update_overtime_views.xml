<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="wizard_update_overtime_form" model="ir.ui.view">
        <field name="model">wizard.update.overtime</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" />
                        <field name="date_start" />
                        <field name="date_end" />
                    </group>
                    <group>
                        <field name="contract_ids" widget="many2many_tags" />
                        <field name="overtime_days_count" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Update Overtime"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
